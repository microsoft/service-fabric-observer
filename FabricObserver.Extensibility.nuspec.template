<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
	<metadata minClientVersion="3.3.4">
		<id>%PACKAGE_ID%</id>
		<version>3.4.0</version>
		<releaseNotes>
			- Targets .NET 8 and .NET 10 for plugin authoring; preserves the existing plugin contract assembly identity.
			- Updated Service Fabric SDK references and shared plugin loading contracts for .NET 10 hosts.
			- Uses supported WCF Client 10.1.0 to resolve the Service Fabric SDK's assembly references during plugin loading.
		</releaseNotes>
		<authors>Microsoft</authors>
		<license type="expression">MIT</license>
		<requireLicenseAcceptance>true</requireLicenseAcceptance>
		<title>Service Fabric FabricObserver Extensibility Library</title>
		<icon>icon.png</icon>
		<readme>foextlib.md</readme>
		<language>en-US</language>
		<description>FabricObserver Extensibility library for .NET 8 and .NET 10 FabricObserver and ClusterObserver plugins. Existing .NET 8 plugins using the documented startup and observer contracts remain supported by the .NET 10 hosts. Deploy the hosts on a supported Service Fabric runtime; Windows requires Service Fabric 11.5 or later.</description>
		<contentFiles>
			<files include="**" buildAction="None" copyToOutput="true" />
		</contentFiles>
		<dependencies>
			<group targetFramework="net8.0">
				<dependency id="Microsoft.ServiceFabric.Services" version="8.5.122" />
				<dependency id="System.ServiceModel.Primitives" version="10.1.0" />
				<dependency id="System.Security.Cryptography.Xml" version="10.0.15" />
				<dependency id="Microsoft.ApplicationInsights" version="2.23.0" />
				<dependency id="Microsoft.ApplicationInsights.NLogTarget" version="2.23.0" />
				<dependency id="Microsoft.Extensions.DependencyInjection" version="9.0.8" />
				<dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="9.0.8" />
				<dependency id="Newtonsoft.Json" version="13.0.3" />
				<dependency id="NLog" version="6.0.3" />
				<dependency id="System.Diagnostics.PerformanceCounter" version="9.0.8" />
				<dependency id="System.Management" version="9.0.8" />
			</group>
			<group targetFramework="net10.0">
				<dependency id="Microsoft.ServiceFabric.Services" version="8.5.122" />
				<dependency id="System.ServiceModel.Primitives" version="10.1.0" />
				<dependency id="System.Security.Cryptography.Xml" version="10.0.15" />
				<dependency id="Microsoft.ApplicationInsights" version="2.23.0" />
				<dependency id="Microsoft.ApplicationInsights.NLogTarget" version="2.23.0" />
				<dependency id="Microsoft.Extensions.DependencyInjection" version="9.0.8" />
				<dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="9.0.8" />
				<dependency id="Newtonsoft.Json" version="13.0.3" />
				<dependency id="NLog" version="6.0.3" />
				<dependency id="System.Diagnostics.PerformanceCounter" version="9.0.8" />
				<dependency id="System.Management" version="9.0.8" />
			</group>
		</dependencies>
		<projectUrl>https://aka.ms/sf/FabricObserver</projectUrl>
		<tags>azure service-fabric fabric-observer utility watchdog-service observability</tags>
		<copyright>© Microsoft Corporation. All rights reserved.</copyright>
	</metadata>
	<files>
		<file src="%ROOT_PATH%\bin\release\FabricObserver.Extensibility\net8.0\FabricObserver.Extensibility.dll" target="lib\net8.0" />
		<file src="%ROOT_PATH%\bin\release\FabricObserver.Extensibility\net8.0\TelemetryLib.dll" target="lib\net8.0" />
		<file src="%ROOT_PATH%\bin\release\FabricObserver.Extensibility\net10.0\FabricObserver.Extensibility.dll" target="lib\net10.0" />
		<file src="%ROOT_PATH%\bin\release\FabricObserver.Extensibility\net10.0\TelemetryLib.dll" target="lib\net10.0" />
		<file src="%ROOT_PATH%\icon.png" target="" />
		<file src="%ROOT_PATH%\foextlib.md" target="" />
	</files>
</package>
