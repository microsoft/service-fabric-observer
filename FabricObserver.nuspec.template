<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
	<metadata minClientVersion="3.3.4">
		<id>%PACKAGE_ID%</id>
		<version>3.4.0</version>
		<releaseNotes>
			- Migrated the application to .NET 10 and Service Fabric SDK 8.5.122.
			- Preserved documented .NET 8 plugin contracts and added .NET 10 plugin authoring assets.
			- Windows deployment requires Service Fabric 11.5 or later; framework-dependent deployment requires .NET 10 on every node.
			- Adds managed-identity Logs Ingestion API support with LegacyOnly, DualWrite, and LogsIngestionOnly modes; LegacyOnly remains the default.
			- Invalid settings and upload failures produce per-API service health warnings, without automatic fallback between APIs.
			- Includes Log Analytics deployment templates and migration verification tooling.
		</releaseNotes>
		<authors>Microsoft</authors>
		<license type="expression">MIT</license>
		<requireLicenseAcceptance>true</requireLicenseAcceptance>
		<title>Service Fabric FabricObserver Application</title>
		<icon>icon.png</icon>
		<readme>fonuget.md</readme>
		<language>en-US</language>
		<description>FabricObserver application targeting .NET 10, with .NET 8 and .NET 10 shared-library assets for plugin authoring. Windows deployment requires Service Fabric 11.5 or later. Framework-dependent deployment requires the .NET 10 runtime on every node; self-contained deployment includes that runtime.</description>
		<contentFiles>
			<files include="**" buildAction="None" copyToOutput="true" />
		</contentFiles>
		<dependencies>
			<group targetFramework="net8.0">
				<dependency id="Microsoft.ServiceFabric.Services" version="8.5.122" />
				<dependency id="Microsoft.ServiceFabricApps.FabricObserver.Extensibility" version="3.4.0" />
				<dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="10.0.15" />
			</group>
			<group targetFramework="net10.0">
				<dependency id="Microsoft.ServiceFabric.Services" version="8.5.122" />
				<dependency id="Microsoft.ServiceFabricApps.FabricObserver.Extensibility" version="3.4.0" />
				<dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="10.0.15" />
			</group>
		</dependencies>
		<projectUrl>https://aka.ms/sf/FabricObserver</projectUrl>
		<tags>azure service-fabric fabric-observer utility watchdog-service observability</tags>
		<copyright>© Microsoft Corporation. All rights reserved.</copyright>
	</metadata>
	<files>
		<file src="**" target="contentFiles\any\any" />
		<file src="FabricObserverPkg\Code\FabricObserver.dll" target="lib\net10.0" />
		<file src="FabricObserverPkg\Code\FabricObserver.Extensibility.dll" target="lib\net10.0" />
		<file src="FabricObserverPkg\Code\TelemetryLib.dll" target="lib\net10.0" />
		<file src="%ROOT_PATH%\bin\release\FabricObserver.Extensibility\net8.0\FabricObserver.Extensibility.dll" target="lib\net8.0" />
		<file src="%ROOT_PATH%\bin\release\FabricObserver.Extensibility\net8.0\TelemetryLib.dll" target="lib\net8.0" />
		<file src="%ROOT_PATH%\icon.png" target="" />
		<file src="%ROOT_PATH%\fonuget.md" target="" />
	</files>
</package>
